{
  "name": "jetstream",
  "private": true,
  "version": "0.1.0",
  "description": "Time tracking, expenses and client billing for JET Engineering.",
  "type": "module",
  "engines": {
    "node": "^18.20.0 || ^20.9.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "tsc -b && node scripts/clean-dist.mjs && vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts src/server/migrate.ts src/server/demoData.ts src/server/adminCreate.ts --bundle --platform=node --target=node18 --format=esm --packages=external --sourcemap --outdir=dist/server",
    "start": "node dist/server/main.js",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo-data.mjs reset --demo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/demo-data.mjs seed",
    "db:reset": "node scripts/demo-data.mjs reset",
    "admin:create": "node scripts/admin-create.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "e2e:install": "node scripts/playwright.mjs install --only-shell chromium",
    "e2e": "npm run build && node scripts/playwright.mjs test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@fontsource-variable/geist": "~5.3.0",
    "drizzle-orm": "~0.45.4",
    "express": "~5.3.0",
    "pg": "~8.23.1",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-router-dom": "~6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@playwright/test": "~1.61.1",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.13",
    "@types/express": "~5.0.6",
    "@types/node": "~18.19.130",
    "@types/pg": "~8.23.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@types/supertest": "~7.2.1",
    "@vitejs/plugin-react": "~4.7.0",
    "axe-core": "~4.14.1",
    "drizzle-kit": "~0.31.11",
    "esbuild": "~0.25.12",
    "eslint": "~9.39.5",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~16.5.0",
    "jsdom": "~26.1.0",
    "supertest": "~7.3.2",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.55.0",
    "vite": "~6.4.6",
    "vitest": "~3.2.7"
  }
}
